{
  "schema": "gazeaudit-install-reference-v1",
  "name": "gazeaudit",
  "version": "0.1.0",
  "requires_python": ">=3.10",
  "tested_python_versions": [
    "3.10",
    "3.11",
    "3.12",
    "3.13"
  ],
  "dependencies": [
    "numpy>=1.24",
    "packaging>=23",
    "pandas>=2.0"
  ],
  "extras": {
    "test": [
      "pytest>=8",
      "pytest-cov>=5",
      "matplotlib>=3.8"
    ],
    "dev": [
      "pytest>=8",
      "pytest-cov>=5",
      "ruff>=0.6"
    ],
    "plot": [
      "matplotlib>=3.8"
    ],
    "pymovements": [
      "pymovements>=0.28,<0.29"
    ],
    "peyes": [
      "peyes>=0.2.2,<0.3; python_version >= '3.12'"
    ],
    "interop": [
      "pymovements>=0.28,<0.29",
      "peyes>=0.2.2,<0.3; python_version >= '3.12'"
    ],
    "gazebase": [
      "pymovements==0.28.0",
      "peyes==0.2.2; python_version >= '3.12'"
    ]
  },
  "scripts": {
    "gazeaudit-gazebase-run": "gazeaudit.gazebase_cli:main",
    "gazeaudit-korthals-source-intake": "gazeaudit.korthals_source_cli:main",
    "gazeaudit-korthals-source-freeze": "gazeaudit.korthals_freeze_cli:main",
    "gazeaudit-korthals-source-intake-v2": "gazeaudit.korthals_source_v2_cli:main",
    "gazeaudit-korthals-source-freeze-v2": "gazeaudit.korthals_freeze_v2_cli:main",
    "gazeaudit-pedrotti-source-intake": "gazeaudit.pedrotti_source_cli:main",
    "gazeaudit-pedrotti-source-freeze": "gazeaudit.pedrotti_freeze_cli:main",
    "gazeaudit-revision-package": "gazeaudit.revision_package_cli:main"
  },
  "urls": {
    "Homepage": "https://github.com/stefanosbalaskas/GazeAudit",
    "Repository": "https://github.com/stefanosbalaskas/GazeAudit",
    "Issues": "https://github.com/stefanosbalaskas/GazeAudit/issues"
  }
}
